{
  "version": 8,
  "name": "Roads by width",
  "description": "Width classes at 8, 10, 12, 14 and 18 metres, which split the data into six roughly even groups holding 22.2, 20.7, 22.1, 18.6, 11.8 and 4.7 percent of segments. Greys carry the two narrowest classes, the local street fabric; orange to dark red carries everything 10 metres and wider, so arterials separate from the background at a glance. Line weight follows the same classes and grows with zoom.",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../road-detections.pmtiles"
    }
  },
  "layers": [
    {
      "id": "road-detections",
      "type": "line",
      "source": "data",
      "source-layer": "road-detections",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "step",
          ["get", "width_meters"],
          "#c9c9c9",
          8, "#a8a8a8",
          10, "#f2a154",
          12, "#e2703a",
          14, "#c1440e",
          18, "#7a2005"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2, ["step", ["get", "width_meters"], 0.05, 10, 0.12, 14, 0.25, 18, 0.5],
          6, ["step", ["get", "width_meters"], 0.15, 10, 0.35, 14, 0.7, 18, 1.3],
          10, ["step", ["get", "width_meters"], 0.5, 10, 1.0, 14, 1.8, 18, 3.0],
          14, ["step", ["get", "width_meters"], 1.2, 10, 2.2, 14, 3.6, 18, 6.0]
        ],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2, 0.35,
          6, 0.6,
          10, 0.85,
          14, 0.95
        ]
      }
    }
  ]
}
